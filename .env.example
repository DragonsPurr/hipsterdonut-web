# Sanity

# NEXT_PUBLIC_SANITY_DATASET="production"
# NEXT_PUBLIC_SANITY_PROJECT_ID="xxxxxxx"

# Umami Analytics
#NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# OVH S3-compatible object storage (shared credentials for all buckets)
# OVH_S3_ENDPOINT=https://s3.ca-east-tor.io.cloud.ovh.net
# OVH_S3_REGION=ca-east-tor
# OVH_S3_ACCESS_KEY=
# OVH_S3_SECRET_KEY=

# User assets bucket (e.g. profile photos)
# OVH_USER_ASSETS_S3_BUCKET=hipsterdonut-user-assets
# OVH_USER_ASSETS_PUBLIC_URL=https://hipsterdonut-user-assets.s3.ca-east-tor.io.cloud.ovh.net

# Site assets bucket (logos, static images)
# OVH_SITE_ASSETS_S3_BUCKET=dp-hd-assets
# OVH_SITE_ASSETS_PUBLIC_URL=https://dp-hd-assets.s3.ca-east-tor.io.cloud.ovh.net

# Medusa Store API
# MEDUSA_BACKEND_URL=https://your-medusa-backend.example.com
# MEDUSA_PUBLISHABLE_KEY=pk_...
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Stripe (must match Medusa backend; enable Stripe on the region in Medusa Admin)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...